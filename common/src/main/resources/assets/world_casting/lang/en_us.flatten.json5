  "world_casting.entry": {
    "quaternions": "Quaternions",
    "quaternion_math": "Quaternion Operations",
    "fragments": "Fragments",
    "fragment_manipulation": "Fragment Manipulation"
  },

  "world_casting.page": {
    "quaternions": {
      "1": "i don't currently have the capacity to explain this in depth so the 3b1b video will have to do for now:",
      "2": "the most important things to note are:$(br2)- A quaternion represents an orientation.$(br2)- Quaternions can be rotated by multiplying them together. The space of the operation depends on the order$(br)(eg. a * b rotates \"a\" locally by \"b\", and the opposite rotates it globally).$(br2)- they look scary but they don't bite i promise"
    },
    "world_casting.quaternion": {
      "identity": "Returns a quaternion that represents no rotation (upright, facing south).",
      "orientation": "Returns a quaternion that represents the orientation of an entity or fragment.",
      "conjugate": "Takes a quaternion and returns its conjugate (inverse)",
      "mul": "Removes a quaternion from the top of the stack and rotates the following quaternion or vector by it.",
      "axis_angle": "Removes a direction and an angle from the stack, and returns a quaternion that represents a rotation by the angle around the axis of the direction",
    },

    "fragments": {
      "1": "Fragments are separated sections of the world capable of moving independently. They can fall, roll around, and collide with things all while everything in them behaves as it would in the rest of the world.$(br)Hexes can interact with them normally as well.",
      "2": "When working with coordinates inside the space of a fragment, they appear localized relative to an arbitrary \"center\" position. Internally, these local positions are very large vectors and still behave like them when operated on."
    },

    "world_casting.sub_level": {
      "get_containing": "Removes a position or an entity from the stack and returns the fragment that contains it (or null).",
      "pos": "Returns the local position of the center of mass for the fragment. $(l:patterns/fragments#world_casting:sub_level.project_position)$(action)Projection Distillation/$ can be used to transform it into global space.",
      "min_bounds": "Returns the position of the local lower-north-west corner of the bounds of the fragment.",
      "max_bounds": "Returns the position of the local upper-south-east corner of the bounds of the fragment.",
      "project_position": "Transforms the given position into the space of the fragment. If the fragment is null, the position is transformed into global space.",
      "get_radius": "Takes a position and a radius, returns every fragment within the radius",
      "mass": "Returns the total mass of the fragment.",
      "gravity": "Returns the gravity vector of the given position.",
      "velocity": "Returns the global velocity at the position within a fragment.",
      "air_pressure": "Returns the air pressure of the given position.",

      "place": "Takes a position and orientation, and places a block from the inventory as a fragment. Costs about an eighth of one Amethyst Dust",
      "assemble": "Takes a position and either a radius or an end position. If a radius is given, makes a fragment from all blocks around the position within the radius. If an end position is given, makes a fragment from all blocks between both positions. Returns the fragment that was created. Costs one Amethyst Dust per block.",
      "merge": "Takes an anchor position inside of a fragment, and a target anchor position in either the world or another fragment. Moves all the blocks from the first fragment to the space of the target position. The cost is the amount of blocks moved + the distance between the anchors in Amethyst Dust.",
      "push": "Remove a position and a direction from the stack, and apply a force at the position if it is within a fragment. Costs one-thousandth of an Amethyst Dust multiplied by the length of the direction and by the sum of the fragment's side lengths.",
      "name": "Takes a fragment and sets the label to the name of the nametag in my other hand"
    }
  },

  "world_casting.display": {
